<Window x:Class="Dolgozatok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dolgozatok"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="tabla" Grid.Row="0" Margin="10" HeadersVisibility="Column"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Név:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="nevBox" Width="185" Height="30"/>
            <TextBlock Text="Életkor:" VerticalAlignment="Center" Margin="20,0,10,0"/>
            <TextBox x:Name="korBox" Width="60" Height="30"/>
            <TextBlock Text="Pontszám:" VerticalAlignment="Center" Margin="20,0,10,0"/>
            <TextBox x:Name="pontBox" Width="60" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
